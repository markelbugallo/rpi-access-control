# ==============================================================================
# Database & Local Persistent Data
# ==============================================================================
# Ignore all SQLite database files (contains admin credentials and access history)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Keep data directory tracked, but ignore generated databases inside
data/*.db
data/*.sqlite*
!data/.gitkeep

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo

# ==============================================================================
# Secrets, Environment Variables & Credentials
# ==============================================================================
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
*.cert
!*.example


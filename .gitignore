!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm & JetBrains IDEs
.idea/
*.iws
*.iml

# Vim / Emacs
*~
.*.sw[a-z]
#*#
.#*

